// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  RECEIPT
  SALE_DEDUCTION
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  COUNT_ADJUSTMENT
}

enum StockCountStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Identity {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  name                    String
  status                  String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             Membership[]
  authenticationProviders AuthenticationProvider[]
  sessions                Session[]
  auditLogs               AuditLog[]
  stockMovements          StockMovement[]
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]
}

model Business {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  taxConfig      String
  currency       String
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     Branch[]
  memberships  Membership[]
  invitations  Invitation[]
  categories   Category[]
  products     Product[]

  @@index([organizationId])
}

model Category {
  id               String         @id @default(uuid()) @db.Uuid
  businessId       String         @db.Uuid
  parentCategoryId String?        @db.Uuid
  name             String
  status           CategoryStatus @default(ACTIVE)

  business        Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parentCategory  Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories Category[] @relation("CategoryHierarchy")
  products        Product[]

  @@index([businessId])
  @@index([parentCategoryId])
}

model Product {
  id         String        @id @default(uuid()) @db.Uuid
  businessId String        @db.Uuid
  categoryId String?       @db.Uuid
  name       String
  sku        String
  barcode    String?
  shortCode  String?
  basePrice  Decimal       @db.Decimal(12, 2)
  costPrice  Decimal?      @db.Decimal(12, 2)
  status     ProductStatus @default(ACTIVE)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryRecords InventoryRecord[]
  stockMovements   StockMovement[]
  stockCountItems  StockCountItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([sku])
  @@index([barcode])
}

model InventoryRecord {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  productId      String   @db.Uuid
  quantityOnHand Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal? @db.Decimal(12, 3)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([branchId, productId])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  branchId      String            @db.Uuid
  productId     String            @db.Uuid
  movementType  StockMovementType
  quantityDelta Decimal           @db.Decimal(12, 3)
  referenceType String?
  referenceId   String?           @db.Uuid
  performedBy   String?           @db.Uuid
  createdAt     DateTime          @default(now())

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  performer Identity? @relation(fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([branchId, productId, createdAt])
  @@index([performedBy])
}

model StockCount {
  id        String           @id @default(uuid()) @db.Uuid
  branchId  String           @db.Uuid
  status    StockCountStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  StockCountItem[]

  @@index([branchId])
}

model StockCountItem {
  id               String   @id @default(uuid()) @db.Uuid
  stockCountId     String   @db.Uuid
  productId        String   @db.Uuid
  systemQuantity   Decimal  @db.Decimal(12, 3)
  countedQuantity  Decimal? @db.Decimal(12, 3)
  varianceQuantity Decimal? @db.Decimal(12, 3)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([productId])
}

model Branch {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  address    String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  inventoryRecords InventoryRecord[]
  stockMovements   StockMovement[]
  stockCounts      StockCount[]

  @@index([businessId])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Membership {
  id         String   @id @default(uuid()) @db.Uuid
  identityId String   @db.Uuid
  businessId String   @db.Uuid
  roleId     String   @db.Uuid
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([identityId, businessId])
  @@index([businessId])
  @@index([roleId])
}

enum ProviderType {
  PASSWORD
  GOOGLE
}

model AuthenticationProvider {
  id           String       @id @default(uuid()) @db.Uuid
  identityId   String       @db.Uuid
  providerType ProviderType
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@unique([identityId, providerType])
  @@index([identityId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  identityId       String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@index([refreshTokenHash])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  identityId String?  @db.Uuid
  eventType  String
  metadata   Json
  createdAt  DateTime @default(now())

  identity Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([identityId])
}

model Invitation {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  roleId     String   @db.Uuid
  email      String
  token      String   @unique
  status     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([roleId])
}
